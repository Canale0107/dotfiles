theme = TokyoNight

background-opacity = 0.85
background-blur = 20
minimum-contrast = 1.3

font-family = JetBrainsMono Nerd Font
font-size = 12

cursor-style = block
cursor-style-blink = false

window-padding-x = 6
window-padding-y = 6

# tmux / Neovim の Alt 修飾キーを使ったキーバインドを有効にする
macos-option-as-alt = left
